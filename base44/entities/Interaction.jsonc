{
  "name": "Interaction",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client that owns this interaction"
    },
    "organization_id": {
      "type": "string",
      "description": "ID of the organization this interaction belongs to"
    },
    "contact_id": {
      "type": "string",
      "description": "ID of the contact this interaction is with"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "meeting",
        "call"
      ],
      "description": "Type of interaction"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the interaction"
    },
    "description": {
      "type": "string",
      "description": "Details about the interaction"
    },
    "interaction_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the interaction took place"
    },
    "duration_minutes": {
      "type": "integer",
      "description": "Duration of meeting/call in minutes"
    },
    "next_followup_date": {
      "type": "string",
      "format": "date",
      "description": "Planned date for next followup"
    }
  },
  "required": [
    "client_id",
    "organization_id",
    "contact_id",
    "type",
    "subject",
    "interaction_date"
  ],
  "rls": {
    "read": {
      "data.client_id": "{{user.data.client_id}}"
    },
    "update": {
      "data.client_id": "{{user.data.client_id}}"
    },
    "delete": {
      "data.client_id": "{{user.data.client_id}}"
    },
    "create": {
      "data.client_id": "{{user.data.client_id}}"
    },
    "write": {
      "data.client_id": "{{user.data.client_id}}"
    }
  }
}