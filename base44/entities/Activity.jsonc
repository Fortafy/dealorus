{
  "name": "Activity",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client this activity belongs to"
    },
    "organization_id": {
      "type": "string",
      "description": "ID of the organization this activity belongs to"
    },
    "contact_id": {
      "type": "string",
      "description": "ID of the contact associated with this activity"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "edit",
        "enrich",
        "star"
      ],
      "description": "Type of action performed on the contact"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the action"
    },
    "fields_changed": {
      "type": "array",
      "description": "Array of fields that were changed",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "old_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "required": [
    "client_id",
    "contact_id",
    "action",
    "description"
  ],
  "rls": {
    "read": {
      "data.client_id": "{{user.data.client_id}}"
    },
    "create": {
      "data.client_id": "{{user.data.client_id}}"
    },
    "update": {
      "data.client_id": "{{user.data.client_id}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "data.client_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.client_id": "{{user.data.client_id}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "data.client_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "data.client_id": "{{user.data.client_id}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "data.client_role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}