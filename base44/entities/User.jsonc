{
  "name": "User",
  "type": "object",
  "properties": {
    "active_client_id": {
      "type": "string",
      "description": "ID of the client the user is currently working in"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "system",
      "description": "User's preferred theme"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether notifications are enabled"
    },
    "email_digest": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "never"
      ],
      "default": "weekly",
      "description": "Email digest frequency"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether two-factor authentication is enabled"
    },
    "invitation_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted"
      ],
      "default": "accepted",
      "description": "Whether the user has accepted their invitation"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user account is active"
    }
  }
}