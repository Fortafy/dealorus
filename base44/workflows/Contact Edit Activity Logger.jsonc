{
  "name": "Contact Edit Activity Logger",
  "description": "Automatically creates activity timeline entries when Contact records are updated",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contact"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contact_edit_activity_logger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logContactActivity",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "logContactActivity"
  }
}